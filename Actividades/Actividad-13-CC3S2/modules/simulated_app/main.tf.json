{
    "resource": [
        {
            "null_resource": [
                {
                    "server1": [
                        {
                            "triggers": {
                                "name": "${var.name}-server1",
                                "network": "${var.network}",
                                "port": "${var.port}"
                            },
                            "provisioner": [
                                {
                                    "local-exec": {
                                        "command": "echo 'Arrancando servidor ${var.name}-server1 en red ${var.network}:${var.port}'"
                                    }
                                }
                            ]
                        }
                    ],
                    "server2": [
                        {
                            "triggers": {
                                "name": "${var.name}-server2",
                                "network": "${var.network}",
                                "port": "${var.port}"
                            },
                            "provisioner": [
                                {
                                    "local-exec": {
                                        "command": "echo 'Arrancando servidor ${var.name}-server2 en red ${var.network}:${var.port}'"
                                    }
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}