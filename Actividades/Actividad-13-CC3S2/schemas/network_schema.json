{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Terraform Network Configuration Schema",
  "description": "Schema para validar archivos network.tf.json",
  "type": "object",
  "required": ["variable"],
  "properties": {
    "variable": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "description"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["string", "number", "bool", "list", "map"]
              },
              "default": {
                "oneOf": [
                  {"type": "string"},
                  {"type": "number"},
                  {"type": "boolean"}
                ]
              },
              "description": {
                "type": "string"
              },
              "sensitive": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
