{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Terraform Main Configuration Schema",
  "description": "Schema para validar archivos main.tf.json",
  "type": "object",
  "required": ["resource"],
  "properties": {
    "resource": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "null_resource": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "triggers": {
                      "type": "object",
                      "properties": {
                        "name": {"type": "string"},
                        "network": {"type": "string"}
                      },
                      "required": ["name", "network"]
                    },
                    "provisioner": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "local-exec": {
                            "type": "object",
                            "required": ["command"],
                            "properties": {
                              "command": {"type": "string"}
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
